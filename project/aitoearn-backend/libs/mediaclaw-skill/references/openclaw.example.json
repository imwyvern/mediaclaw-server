{
  "name": "mediaclaw-client",
  "command": "./scripts/mediaclaw-client",
  "args": [],
  "endpoint": {
    "baseUrl": "${MEDIACLAW_BASE_URL:-https://api.mediaclaw.com}"
  },
  "env": [
    "MEDIACLAW_API_KEY",
    "MEDIACLAW_AGENT_ID",
    "MEDIACLAW_CLIENT_VERSION"
  ],
  "autoCheck": {
    "enabled": true,
    "intervalSeconds": 300,
    "command": "heartbeat --agent ${MEDIACLAW_AGENT_ID}"
  },
  "downloadDir": "${MEDIACLAW_DOWNLOAD_DIR:-./downloads/mediaclaw}",
  "notification": {
    "onDelivery": true,
    "onApprovalRequired": true,
    "onPublished": true
  }
}
