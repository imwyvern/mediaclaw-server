#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLIENT_TS="$SCRIPT_DIR/mediaclaw-client.ts"

find_workspace_root() {
  local dir="$SCRIPT_DIR"

  while [[ "$dir" != "/" ]]; do
    if [[ -x "$dir/node_modules/.bin/ts-node-script" && -f "$dir/tsconfig.base.json" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  return 1
}

WORKSPACE_ROOT="$(find_workspace_root || true)"

if [[ -z "$WORKSPACE_ROOT" ]]; then
  echo "Workspace root not found. Install workspace dependencies before running MediaClaw Client." >&2
  exit 1
fi

TS_NODE_SCRIPT="$WORKSPACE_ROOT/node_modules/.bin/ts-node-script"
TSCONFIG_PATH="$WORKSPACE_ROOT/tsconfig.base.json"

exec "$TS_NODE_SCRIPT" --project "$TSCONFIG_PATH" --transpile-only "$CLIENT_TS" "$@"
