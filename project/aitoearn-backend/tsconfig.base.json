{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "rootDir": ".",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "useDefineForClassFields": false,
    "paths": {
      "@yikart/ali-oss": ["libs/ali-oss/src/index.ts"],
      "@yikart/ali-sms": ["libs/ali-sms/src/index.ts"],
      "@yikart/aitoearn-ai-client": ["libs/aitoearn-ai-client/src/index.ts"],
      "@yikart/aitoearn-auth": ["libs/aitoearn-auth/src/index.ts"],
      "@yikart/aitoearn-queue": ["libs/aitoearn-queue/src/index.ts"],
      "@yikart/assets": ["libs/assets/src/index.ts"],
      "@yikart/aws-s3": ["libs/aws-s3/src/index.ts"],
      "@yikart/common": ["libs/common/src/index.ts"],
      "@yikart/helpers": ["libs/helpers/src/index.ts"],
      "@yikart/mediaclaw-agent-runtime": ["libs/mediaclaw-agent-runtime/src/index.ts"],
      "@yikart/mediaclaw-shared-kernel": ["libs/mediaclaw-shared-kernel/src/index.ts"],
      "@yikart/mediaclaw-tools-ingest": ["libs/mediaclaw-tools-ingest/src/index.ts"],
      "@yikart/mediaclaw-tools-branding": ["libs/mediaclaw-tools-branding/src/index.ts"],
      "@yikart/mediaclaw-tools-generation": ["libs/mediaclaw-tools-generation/src/index.ts"],
      "@yikart/mediaclaw-tools-audio-text": ["libs/mediaclaw-tools-audio-text/src/index.ts"],
      "@yikart/mediaclaw-tools-compose": ["libs/mediaclaw-tools-compose/src/index.ts"],
      "@yikart/mediaclaw-tools-quality": ["libs/mediaclaw-tools-quality/src/index.ts"],
      "@yikart/mediaclaw-tools-intelligence": ["libs/mediaclaw-tools-intelligence/src/index.ts"],
      "@yikart/mediaclaw-tools-platform": ["libs/mediaclaw-tools-platform/src/index.ts"],
      "@yikart/mediaclaw-tools-strategy": ["libs/mediaclaw-tools-strategy/src/index.ts"],
      "@yikart/mongodb": ["libs/mongodb/src/index.ts"],
      "@yikart/nest-mcp": ["libs/nest-mcp/src/index.ts"],
      "@yikart/redis": ["libs/redis/src/index.ts"],
      "@yikart/redlock": ["libs/redlock/src/index.ts"]
    },
    "strict": true,
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "declaration": false,
    "importHelpers": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "tmp"]
}
